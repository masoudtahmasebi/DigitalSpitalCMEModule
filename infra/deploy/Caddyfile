# TLS termination and routing (P10-04).
#
# Caddy obtains and renews Let's Encrypt certificates for every hostname below,
# automatically. There is no certbot, no renewal cron and no hook to forget:
# the hostnames in this file *are* the certificate configuration.
#
# For that to work, each domain's A/AAAA record must already point at this host
# before the container starts — ACME's HTTP-01 challenge is served on :80 by
# Caddy itself. A domain that does not resolve here simply fails to get a
# certificate and logs why; it does not take the other domains down.

{
	email {$ACME_EMAIL}

	# Uncomment to use Let's Encrypt's staging CA while testing DNS. Production
	# has a rate limit of 5 duplicate certificates per week, and burning it on
	# a typo means waiting seven days.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Headers every response gets. Kept in one snippet so a new site cannot quietly
# ship without them.
(baseline) {
	header {
		# One year, preload-eligible. Only meaningful once the domain is
		# confirmed HTTPS-only — which it is, since Caddy redirects :80.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing here needs a camera, a microphone or geolocation.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		# Caddy's version is not information anyone outside needs.
		-Server
	}
}

# The bare domain, when there is anything to say there.
#
# `digitalspital.com` is not one of the four service hostnames — it is free for
# a promotional site. `deploy.sh` writes `apex.caddy` into the state directory
# when APEX_REDIRECT_URL is set and removes it when it is not, so this import is
# a glob: Caddy accepts a glob matching nothing, and there is no way to write
# "an optional site block" in the Caddyfile itself.
import /etc/caddy/sites/*.caddy

# ---------------------------------------------------------------------------
# The API
# ---------------------------------------------------------------------------
{$API_DOMAIN} {
	import baseline

	# The API is JSON and PDFs. Framing it achieves nothing, and a page that
	# could frame it could read a physician's certificate.
	header X-Frame-Options "DENY"

	# `/metrics` is not for the internet (P113-02).
	#
	# `MetricsController` is `@Public()` — a Prometheus scraper cannot present a
	# bearer token — and *both* that controller and `observability/metrics.ts`
	# justified publishing `ds_build_info{commit="…"}` there with the same
	# sentence: that this file "does not route /metrics from the edge, so an
	# external scraper needs an SSH tunnel".
	#
	# It did route it. A site block whose only handler is a bare `reverse_proxy`
	# is a catch-all: it matches every path, and nothing below filtered one out.
	# So the sentence described a matcher nobody had written, and the version
	# fingerprint that comment was explicitly avoiding putting on a public
	# endpoint has been served to anyone who asked for it.
	#
	# That is §9.1 exactly — a property asserted in two files, checked in none,
	# and therefore unable to go red. `deploy-vars.test.sh` now checks it, and
	# the matcher below is what it checks for.
	#
	# `respond 404` and not `403`: a 403 confirms that something is there, which
	# is the oracle §9.5 refuses. An operator still scrapes it the way the
	# comment always claimed they did — from inside the Docker network, against
	# `api:3000`, where Caddy is not in the path at all.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# CORS is handled by the API itself, from CORS_ALLOWED_ORIGINS — not here.
	# Two places deciding which origins may call the API is one place too many,
	# and the API is the one that can refuse the request as well as the
	# preflight.
	reverse_proxy api:3000 {
		# Without these the API sees Caddy's address as the client, which
		# makes rate limiting per-proxy rather than per-caller.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Request bodies. Two limits, because one endpoint is genuinely different:
	# a white-label font may be 2 MB and base64 inflates it to ~2.8 MB, while
	# every other request here is a small JSON document. A single 2 MB limit
	# refused a legitimate font upload with a 413 that never reached the API,
	# and a single 4 MB limit would hand every other endpoint a four-megabyte
	# allowance for no reason.
	#
	# The API enforces the same split again (MAX_FONT_BODY_SIZE), and the 2 MB
	# rule on the file itself is enforced a third time by a CHECK constraint.
	# This layer exists to stop a large body being buffered at all.
	@font_upload path /admin/branding/font
	request_body @font_upload {
		max_size 4MB
	}
	request_body {
		max_size 2MB
	}
}

# ---------------------------------------------------------------------------
# The admin console
# ---------------------------------------------------------------------------
{$ADMIN_DOMAIN} {
	import baseline
	header X-Frame-Options "DENY"

	# A strict CSP is affordable here because this app loads nothing from
	# anywhere else: its own bundle, its own styles, and XHR to the API.
	# `unsafe-inline` for styles is Vite's injected critical CSS; the script
	# policy has no such escape.
	#
	# `connect-src` no longer names Keycloak. The console authenticates on the
	# platform's own staff plane (ADR-0012, P12-06) and never calls a realm, so
	# listing one would be a permission granted to a request that is not made —
	# and the first person to reuse this policy elsewhere would inherit it.
	#
	# It *does* name the object storage bucket, because a course video is
	# uploaded by the browser straight to it with a presigned PUT the API mints
	# (P23-01, P67-01). The API never sees the bytes, which is the point — 2 GB
	# through a Node process is a Node process falling over. Without this origin
	# every upload is blocked before a byte moves, and the only evidence is a
	# console message in the operator's browser.
	#
	# `S3_ORIGIN` is derived from `S3_ENDPOINT` by domains.sh, and empty when no
	# bucket is configured — which collapses the directive back to what it was
	# and is correct: no bucket, no uploads.
	#
	# `media-src` is here for the other direction (P74-03). The console shows an
	# author the video they uploaded and reads its length out of its own header,
	# both of which load media from the bucket — and `default-src 'self'` refuses
	# that with a message no server log contains:
	#
	#     Refused to load media from 'https://…/video-….webm' because it
	#     violates the following Content Security Policy directive:
	#     "default-src 'self'". Note that 'media-src' was not explicitly set,
	#     so 'default-src' is used as a fallback.
	#
	# Exactly the shape of P67-01, one directive along: `connect-src` was fixed
	# for the upload and the read half was not, because nothing read yet. The
	# portal's policy below has carried a `media-src` since it was written, for
	# the learner's player — the console needed the same and did not have it.
	#
	# `object-src` is the same story a third time (P161-02). `media-src` covers
	# `<video>` and `<audio>`; a PDF in the Mediathek is an `<embed>`, and an
	# `<embed>` is governed by `object-src` — which was not set, so it fell back
	# to `default-src 'self'` and every PDF preview was blocked:
	#
	#     Loading plugin data from 'https://…/material-….pdf' violates the
	#     following Content Security Policy directive: "default-src 'self'".
	#     Note that 'object-src' was not explicitly set, so 'default-src' is
	#     used as a fallback. The action has been blocked.
	#
	# Three directives, three separate discoveries, one per file type somebody
	# eventually clicked. The rule that would have found all three at once is
	# not "add every directive" — the paragraph above is right that a permission
	# for a request nobody makes is a permission to delete — it is: for every
	# element the console points at the bucket, name the directive that governs
	# it. Today that is `<img>` (img-src), `<video>`/`<audio>` (media-src),
	# `<embed>` (object-src) and `fetch` (connect-src). There is no `<iframe>`
	# and no `<object>` anywhere in apps/admin, so no `frame-src` is listed.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: {$S3_ORIGIN}; media-src 'self' {$S3_ORIGIN}; object-src 'self' {$S3_ORIGIN}; connect-src 'self' {$API_DOMAIN_URL} {$S3_ORIGIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"

	reverse_proxy admin:80
}

# ---------------------------------------------------------------------------
# The standalone portal
# ---------------------------------------------------------------------------
{$PORTAL_DOMAIN} {
	import baseline
	header X-Frame-Options "DENY"

	# Same policy as the console, and for the same reason: this app loads
	# nothing from anywhere else. `ds-lms.js` is served from this very origin
	# — the portal ships its own copy rather than pointing at the widget
	# domain, so `script-src 'self'` covers it and a learner's browser makes no
	# cross-origin request to start a Fortbildung.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' {$API_DOMAIN_URL} {$KEYCLOAK_ORIGIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"

	reverse_proxy portal:80
}

# ---------------------------------------------------------------------------
# The widget bundle
# ---------------------------------------------------------------------------
{$WIDGET_DOMAIN} {
	import baseline

	# Deliberately no X-Frame-Options and no restrictive CORP: this file is
	# meant to be loaded by other origins. Its own nginx sets the CORS headers.
	reverse_proxy widget:80
}
