#!/usr/bin/env bash
#
# `docker compose` for this deployment, with the environment already loaded.
#
# The stack's configuration lives in two files outside the git clone, and
# `deploy.sh` sources both before it calls compose. Without that, a bare
# `docker compose ps` interpolates an empty `${DS_COMMIT}` and reports on a
# stack that does not exist — which reads as "everything is down".
#
#   ./dsc ps
#   ./dsc logs -f api
#   ./dsc exec -T postgres psql -U postgres -d ds_education
#
# It deliberately does *not* deploy. `deploy.sh` is that, and a wrapper that
# could also restart things is a wrapper somebody restarts things with by
# accident.

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly STATE_DIR="${DS_STATE_DIR:-${HOME}/ds-education}"

[[ -f "${STATE_DIR}/config.env" ]] || {
  echo "missing ${STATE_DIR}/config.env — see infra/deploy/config.env.example" >&2
  exit 1
}

# The two files are generated or hand-written on the host; shellcheck cannot
# follow either, and should not try.
set -a
# shellcheck disable=SC1090,SC1091
source "${STATE_DIR}/config.env"
if [[ -f "${STATE_DIR}/secrets.env" ]]; then
  # shellcheck disable=SC1090,SC1091
  source "${STATE_DIR}/secrets.env"
fi
set +a

# shellcheck source=./domains.sh
source "${SCRIPT_DIR}/domains.sh"
ds_derive_domains

# The percent-encoded passwords the compose file interpolates. `dsc` sources
# `secrets.env` directly rather than through `ds_ensure_secrets` — it must never
# generate anything — so it derives them itself.
#
# Without this, `${DS_APP_PASSWORD_URL}` interpolates blank and every container
# started through `dsc` gets `postgres://ds_app:@postgres:5432/…`. Postgres
# refuses that with "client password must be a string", which reads like a
# broken credential and is a missing one.
# shellcheck source=./secrets.sh
source "${SCRIPT_DIR}/secrets.sh"
ds_export_url_passwords

# shellcheck source=./images.sh
source "${SCRIPT_DIR}/images.sh"

# The release number, so a container started through `dsc` reports the same one
# a deploy would (P47-01). Not fatal here: `dsc` is also how somebody inspects a
# broken checkout, and refusing to run `./dsc logs` because a version cannot be
# derived would be a wrapper getting in the way of debugging itself.
# shellcheck source=./version.sh
source "${SCRIPT_DIR}/version.sh"
ds_derive_version "${SCRIPT_DIR}/../.." 2>/dev/null || {
  DS_VERSION="unknown"
  export DS_VERSION
}

# The image tag is the commit this clone is on, exactly as deploy.sh computes
# it. So `./dsc` describes the checkout you are standing in — which is the
# right answer, and the reason a rollback is `git checkout` plus a redeploy.
DS_COMMIT="$(git -C "$SCRIPT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
export DS_COMMIT

# ---------------------------------------------------------------------------
# `./dsc as-migrator <dist/x.js> [args…]`, and `./dsc seed <name>` over it
# ---------------------------------------------------------------------------
#
# ## Why these exist at all
#
# Three of the image's entrypoints — the seeds and the subject-erasure tool —
# connect as `ds_migrator`, and that connection string is assembled from two
# files this script sources and the operator's interactive shell does not. The
# deployment guide asked people to type
#
#   ./dsc run --rm --entrypoint node api dist/seed-ds.js --force
#
# for three releases, and it could not work: `MIGRATION_DATABASE_URL` was never
# set, so the seed refused before opening a connection. Adding the `-e` by hand
# does not help either — `${DS_MIGRATOR_PASSWORD_URL}` expands in the *caller's*
# shell, which has never seen `secrets.env`. The erasure runbook had the same
# line with the *un-encoded* password, which additionally breaks the URL the
# moment a generated password contains a `/` or a `+`.
#
# ## Why the API container does not simply carry the variable
#
# Because then it would hold a migrator credential for its whole life. `ds_app`
# is deliberately not `ds_migrator`: it may not create a customer, and it is
# subject to RLS (ADR-0002). Injecting the URL into one short-lived container
# that exits is the narrow version of the same convenience.
#
# Both start a one-shot container and touch no running service — the reason
# `dsc` refuses to deploy still holds.
#
# ## Why it does not build (P43-03)
#
# It used to, without ever saying so. `docker compose run` builds a service
# whose image is absent, and the image tag is `${DS_COMMIT}` — the commit this
# clone is on — so a `git pull` was enough to make `./dsc seed medice` spend
# forty seconds compiling the whole API before it did anything. That is a
# deploy's work, from the wrapper whose header says it deliberately does not
# deploy, and it produces an image built from a commit that is not the one
# running: the container it starts is then a *different build* from the API
# beside it, which is the one confusion this stack can least afford
# (CLAUDE.md §9.9).
#
# So: use an image that is already on the disk, and never build one. Preferring
# HEAD's, falling back to whatever the running API is, because a seed's job is
# to write rows the running API will read and the running API's schema is the
# one they have to fit.
ds_as_migrator() {
  local tag
  if ! tag="$(ds_resolve_image_tag "${SCRIPT_DIR}/docker-compose.prod.yml" "${DS_COMMIT}")"; then
    echo "No ds-education/api image on this host, and there is no registry to" >&2
    echo "pull one from (ADR-0013). Build and deploy first:" >&2
    echo >&2
    echo "    ./deploy.sh" >&2
    echo >&2
    echo "This wrapper deliberately does not build — a 40-second image build is" >&2
    echo "a deploy's work, and it would run whatever commit this clone happens" >&2
    echo "to be on rather than what is serving traffic." >&2
    exit 3
  fi

  if [[ "$tag" != "${DS_COMMIT}" ]]; then
    # Not a warning to be skimmed: it is the difference between "the seed did
    # not work" and "the seed ran against a build from a different commit".
    echo "note: this clone is at ${DS_COMMIT}, but the API image on this host is" >&2
    echo "      ${tag} — using that one, because it is what is running. Deploy" >&2
    echo "      to close the gap." >&2
  fi

  # No `--no-build`: an older `docker compose run` does not have that flag and
  # rejects the whole command with `unknown flag: --no-build` (P49-02). It was
  # redundant here anyway — `ds_resolve_image_tag` has already established that
  # this image is on the disk, and compose only builds when one is missing.
  exec env DS_COMMIT="$tag" \
    docker compose -f "${SCRIPT_DIR}/docker-compose.prod.yml" run --rm \
    -e MIGRATION_DATABASE_URL="postgres://ds_migrator:${DS_MIGRATOR_PASSWORD_URL}@postgres:5432/${POSTGRES_DB}" \
    --entrypoint node api "$@"
}

if [[ "${1:-}" == "as-migrator" ]]; then
  shift
  [[ $# -gt 0 ]] || {
    echo "usage: ./dsc as-migrator <dist/entrypoint.js> [args…]" >&2
    exit 2
  }
  ds_as_migrator "$@"
fi

if [[ "${1:-}" == "seed" ]]; then
  shift
  case "${1:-}" in
    default) seed_entrypoint=dist/seed-ds-default.js ;;
    ds) seed_entrypoint=dist/seed-ds.js ;;
    medice) seed_entrypoint=dist/seed-medice.js ;;
    *)
      echo "usage: ./dsc seed {default|ds|medice} [--if-missing]" >&2
      echo >&2
      echo "  default  DSCustomer — the one a deploy creates for itself" >&2
      echo "  ds       the DS test tenant, two demo courses" >&2
      echo "  medice   MEDICE's real ADHS course" >&2
      echo >&2
      echo "Without --if-missing a seed REBUILDS its courses' content, which" >&2
      echo "deletes learner progress on those courses." >&2
      exit 2
      ;;
  esac
  shift
  ds_as_migrator "$seed_entrypoint" "$@"
fi

exec docker compose -f "${SCRIPT_DIR}/docker-compose.prod.yml" "$@"
