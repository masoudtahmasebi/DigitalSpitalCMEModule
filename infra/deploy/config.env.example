# The deployment's configuration (P16-01, P17-01).
#
# Copy to `~/ds-education/config.env` **on the server**, fill it in once, and
# leave it there. Deployments never overwrite it, and nothing in it is in git.
#
#   install -m 600 /dev/null ~/ds-education/config.env
#   $EDITOR ~/ds-education/config.env
#
# ## What is *not* here
#
# The database passwords and the encryption key. `deploy.sh` generates those on
# first run into `~/ds-education/secrets.env` and never regenerates them —
# nobody reads them, nobody types them, and no decision is encoded in 32 random
# bytes. See `secrets.sh`.
#
# The four service hostnames, the API origin, the staff cookie's scope, the CORS
# allow-list, the portal's base URL and the widget's URL. All derived from
# BASE_DOMAIN by `domains.sh`. You may set any of them explicitly and it wins;
# you should not need to.
#
# ## What is here
#
# Answers. Things no default can be right about.

# --- The domain -------------------------------------------------------------
# A bare domain: no scheme, no port, no path, no trailing dot. Its A/AAAA
# records must resolve to this host before the first deploy — Caddy proves
# control of each hostname with an HTTP-01 challenge on :80.
BASE_DOMAIN=digitalspital.com

# Which project the console and the portal act within, sent as `X-DS-Project`.
# Names a row in `projects`, so it cannot be derived from a domain.
PROJECT_SLUG=medice-adhs

# Where Let's Encrypt sends expiry warnings. A real, monitored mailbox — this
# is the last warning before a certificate lapses.
ACME_EMAIL=technik@digitalspital.de

# --- The customer's own origins ---------------------------------------------
# The console and the portal are added to the CORS allow-list automatically.
# This is for the customer's WordPress site — somebody else's domain, so
# nothing can derive it. Comma-separated, exact origins, scheme included.
EXTRA_CORS_ORIGINS=https://www.medice.de

# --- The portal's Keycloak client -------------------------------------------
# **Per project, not per platform.**
#
# The API does not read these and has no Keycloak configuration of its own: it
# validates each learner's token against the issuer on the *project row*
# (`projects.keycloak_issuer`), per request, which is what lets one installation
# serve several customers with separate realms. Three deployment-wide Keycloak
# variables used to exist here and were read by nothing (P17-02).
#
# What remains is the **portal's** OIDC client, because a browser app has to
# know where to send a learner before it has spoken to any API. It must be the
# same realm as the project named by PROJECT_SLUG above — `deploy.sh` warns if
# the two disagree, which is otherwise a learner signing in successfully and
# then having every request rejected.
#
# A learner-facing *public* client with the portal's redirect URI, separate from
# anything the customer's WordPress site uses, so the two revoke independently.
PORTAL_KEYCLOAK_ISSUER=https://login.medice.de/realms/medice
PORTAL_KEYCLOAK_CLIENT_ID=ds-portal

# --- The bare domain (optional) ---------------------------------------------
# `digitalspital.com` itself is not one of the four service hostnames — it is
# free for a promotional site. Until there is one, setting this makes Caddy
# serve a redirect there so the bare domain is not a TLS error; leave it empty
# and Caddy has no site block for the apex at all.
APEX_REDIRECT_URL=

# --- Alerting ---------------------------------------------------------------
# Where a Punktemeldung deadline alarm is posted. Optional: every alert is
# logged at `error` regardless, so log-based alerting is the floor. A webhook is
# what turns that into something that reaches a person on a Saturday — which
# matters, because the Ärztekammer's reporting window is 8 days and its paper
# fallback closes with it.
#
# Generic JSON, so a Slack/Teams incoming webhook, PagerDuty, or an internal
# endpoint all work. The payload carries an enrolment id and an urgency, never
# an EFN or a name.
ALERT_WEBHOOK_URL=

# --- Database name ----------------------------------------------------------
# The passwords are generated; only the names are decisions.
POSTGRES_DB=ds_education
POSTGRES_SUPERUSER=postgres

# --- Body size limits -------------------------------------------------------
# The font upload needs its own: the column allows a 2 MB file and base64
# inflates that to ~2.8 MB. Everything else stays at 1 MB — a JSON parser is a
# denial-of-service surface.
MAX_REQUEST_BODY_SIZE=1mb
MAX_FONT_BODY_SIZE=3mb

# --- Certificate delivery (P8-03) ------------------------------------------
# SMTP is configured per project in the admin console, not here. These are the
# worker's knobs. Delivery never gates the download: a certificate that cannot
# be emailed is still downloadable, and shows as "unzustellbar" in the
# participant list. The download link's base is derived (PORTAL_BASE_URL).
CERTIFICATE_DELIVERY_ENABLED=yes
CERTIFICATE_DELIVERY_INTERVAL_SEC=300
CERTIFICATE_DELIVERY_BATCH_SIZE=25

# --- EIV-FOBI --------------------------------------------------------------
# Leave pointing at the mock until the ÄKWL questions in docs/show-stoppers.md
# are answered. A Punktemeldung cannot be withdrawn once the 7-day correction
# window closes, so the live endpoint additionally requires EIV_ALLOW_LIVE=yes
# — and the deploy script refuses the combination of a live URL without it.
#
# The real endpoint, when the time comes: https://punktemeldung.eiv-fobi.de/
EIV_BASE_URL=http://127.0.0.1:4010
EIV_ALLOW_LIVE=
# Exactly one submitter, however many API containers run. Two workers racing
# for the same submission is a duplicate report to the Ärztekammer.
EIV_WORKER_ENABLED=yes

# --- Object storage (optional) ---------------------------------------------
# All of it or none of it. Empty means courses serve media from plain https://
# URLs; set means a course row may hold `s3://<customerId>/courses/<id>/<file>`
# and the API signs it per object, briefly, after the gate agrees.
#
# S3-compatible, in Germany. Hetzner Object Storage endpoints look like
# https://fsn1.your-objectstorage.com (region fsn1 / eu-central-1).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=yes
S3_URL_TTL_SEC=3600
