# Template for the `PRODUCTION_ENV` GitHub secret (P10-04, P16-01).
#
# Fill this in, paste the whole thing into the repository secret named
# `PRODUCTION_ENV`, and the deploy workflow writes it to
# `~/ds-education/infra/deploy/.env.production` on the host with mode 600.
#
# **This file is a template. It must never contain a real value in git.**
# The deploy script refuses to run if the file on the host is not 600, and the
# repository's gitleaks job fails on a committed credential.
#
# `IMAGE_API`, `IMAGE_ADMIN`, `IMAGE_PORTAL` and `IMAGE_WIDGET` are appended by
# the workflow — do not put them here, or a redeploy will pin an old tag.
#
# ## One domain, not twelve
#
# Everything below the first block is derived by `domains.sh`: the four
# hostnames, the API origin the console's CSP names, the staff cookie's scope,
# the CORS allow-list, the certificate email's link target, and what the two
# browser bundles are told at container start.
#
# You may still set any of them explicitly and it will win — but you should not
# have to, and every one you set by hand is one more thing that can disagree
# with the others. The disagreements are quiet: a wrong `API_DOMAIN_URL` blocks
# the console's every request in the browser with nothing in any server log.

# --- The one you actually set ----------------------------------------------
# A bare domain: no scheme, no port, no path, no trailing dot.
#
# Its A/AAAA records must already point at this host before the first deploy —
# Caddy proves control over each hostname with an HTTP-01 challenge on :80, and
# a name that does not resolve here simply never gets a certificate. A wildcard
# `*.digitalspital.com` covers all four at once.
BASE_DOMAIN=digitalspital.com

# Which project the console and the portal act within, sent as `X-DS-Project`.
# Names a row in `projects`, so it cannot be derived from a domain.
PROJECT_SLUG=medice-adhs

# Where Let's Encrypt sends expiry warnings. A real, monitored mailbox — this
# is the last warning before a certificate lapses.
ACME_EMAIL=technik@digitalspital.de

# --- Derived, and normally left alone --------------------------------------
# Shown so the derivation is legible, not because you need to set them.
#
#   API_DOMAIN            api.digitalspital.com
#   ADMIN_DOMAIN          verwaltung.digitalspital.com
#   PORTAL_DOMAIN         fortbildung.digitalspital.com
#   WIDGET_DOMAIN         widget.digitalspital.com
#   API_DOMAIN_URL        https://api.digitalspital.com
#   PORTAL_BASE_URL       https://fortbildung.digitalspital.com
#   WIDGET_URL            https://widget.digitalspital.com/ds-lms.js
#   STAFF_COOKIE_DOMAIN   .digitalspital.com
#   CORS_ALLOWED_ORIGINS  https://verwaltung.…,https://fortbildung.…
#
# The labels are overridable one at a time — `ADMIN_LABEL=admin` gives
# `admin.digitalspital.com` and leaves the rest derived. The German names are
# DigitalSpital's convention, not a property of the software.
#
# ## One thing to know about STAFF_COOKIE_DOMAIN
#
# It is the parent of the console and the API so the browser treats them as
# same-site and attaches the staff session cookie (ADR-0012). With a flat layout
# that parent is the **whole company domain**, so every present and future host
# under it receives the cookie. It is httpOnly — no script can read it — but a
# subdomain somebody else operates would see it in its access logs.
#
# Putting the platform under its own second-level name (`BASE_DOMAIN=cme.…`)
# narrows that to the platform's own hosts. It needs a second wildcard DNS
# record, because a wildcard matches exactly one label.

# --- CORS: the origins that are not ours -----------------------------------
# The console and the portal are added automatically. This is for the
# customer's own site — somebody else's domain, so nothing can derive it.
# Comma-separated, exact origins, scheme included.
EXTRA_CORS_ORIGINS=https://www.medice.de

# Body size limits. The font upload needs its own: the column allows a 2 MB
# file and base64 inflates that to ~2.8 MB. Everything else stays at 1 MB —
# a JSON parser is a denial-of-service surface.
MAX_REQUEST_BODY_SIZE=1mb
MAX_FONT_BODY_SIZE=3mb

# --- Alerting ---------------------------------------------------------------
# Where a Punktemeldung deadline alarm is posted. Optional: every alert is
# logged at `error` regardless, so log-based alerting is the floor. A webhook is
# what turns that into something that reaches a person on a Saturday — which
# matters, because the Ärztekammer's reporting window is 8 days and its paper
# fallback closes with it.
#
# Generic JSON, so a Slack/Teams incoming webhook, PagerDuty, or an internal
# endpoint all work. The payload carries an enrolment id and an urgency, never
# an EFN or a name.
ALERT_WEBHOOK_URL=

# --- Database --------------------------------------------------------------
# Long random values. `openssl rand -base64 32` for each; they are never typed
# by a human and never appear in a URL bar.
POSTGRES_DB=ds_education
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
# ds_migrator owns the schema. ds_app is NOT BYPASSRLS and owns nothing —
# ADR-0002 depends on that, and infra/postgres/init-roles.sql creates both.
DS_MIGRATOR_PASSWORD=
DS_APP_PASSWORD=

# --- Keycloak --------------------------------------------------------------
# The API validates every learner's bearer token against these. They are not
# secret; they are the trust anchor, and a wrong value means every request 401s.
#
# This is the **customer's** realm — MEDICE's — not ours. The admin console does
# not use it at all (ADR-0012): staff sign in on the platform's own identity
# plane, so nothing here affects the console.
KEYCLOAK_ISSUER=https://login.medice.de/realms/medice
KEYCLOAK_AUDIENCE=ds-education-api
KEYCLOAK_JWKS_URI=https://login.medice.de/realms/medice/protocol/openid-connect/certs

# The portal's own public client in that realm — a learner-facing client with
# the portal's redirect URI, separate from anything the customer's WordPress
# site uses so the two can be revoked independently.
PORTAL_KEYCLOAK_CLIENT_ID=ds-portal

# --- Encryption at rest (CLAUDE.md §4 invariant 7) --------------------------
# 32 bytes, base64. Protects the VNR password and SMTP credentials in their
# `_enc` columns.
#
#   openssl rand -base64 32
#
# The API refuses to start in production without it, deliberately: there is no
# plaintext fallback. Store it in the deployment's secret store, not in git.
#
# Rotating it is not yet a one-liner — existing rows are encrypted under the
# old key and need re-encrypting. See P0-05.
SECRETS_KMS_KEY=

# --- Certificate delivery (P8-03) ------------------------------------------
# SMTP is configured per project in the admin console, not here. These are the
# worker's knobs. Delivery never gates the download: a certificate that cannot
# be emailed is still downloadable, and shows as "unzustellbar" in the
# participant list. The download link's base is derived (PORTAL_BASE_URL).
CERTIFICATE_DELIVERY_ENABLED=yes
CERTIFICATE_DELIVERY_INTERVAL_SEC=300
CERTIFICATE_DELIVERY_BATCH_SIZE=25

# --- EIV-FOBI --------------------------------------------------------------
# Leave pointing at the mock until the ÄKWL questions in docs/show-stoppers.md
# are answered. A Punktemeldung cannot be withdrawn once the 7-day correction
# window closes, so the live endpoint additionally requires EIV_ALLOW_LIVE=yes
# — and the deploy script refuses the combination of a live URL without it.
#
# The real endpoint, when the time comes: https://punktemeldung.eiv-fobi.de/
EIV_BASE_URL=http://127.0.0.1:4010
EIV_ALLOW_LIVE=
# Exactly one submitter, however many API containers run. Two workers racing
# for the same submission is a duplicate report to the Ärztekammer.
EIV_WORKER_ENABLED=yes

# --- The bare domain (optional) --------------------------------------------
# `digitalspital.com` itself is not one of the four service hostnames — it is
# free for a promotional site. Until there is one, setting this makes Caddy
# serve a redirect there so the bare domain is not a TLS error; leave it empty
# and Caddy has no site block for the apex at all.
#
# Set it to a full URL, e.g. https://fortbildung.digitalspital.com
APEX_REDIRECT_URL=

# --- Object storage (optional) ---------------------------------------------
# All of it or none of it. Empty means courses serve media from plain https://
# URLs; set means a course row may hold `s3://<customerId>/courses/<id>/<file>`
# and the API signs it per object, briefly, after the gate agrees.
#
# S3-compatible, in Germany. Hetzner Object Storage endpoints look like
# https://fsn1.your-objectstorage.com (region fsn1 / eu-central-1).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=yes
S3_URL_TTL_SEC=3600
