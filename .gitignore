node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

.env
.env.*
!.env.example

.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

.idea/
.vscode/*
!.vscode/extensions.json

# packages/sdk/src/generated/ is deliberately COMMITTED, not ignored: CI's
# drift check regenerates it and fails on `git diff -- packages/sdk`, which
# only bites if the generated output is tracked. Never hand-edit it.

# ad-hoc local smoke/debug scripts — never committed
*.local.mjs
*.local.ts

# Redis snapshot, written by a locally-started redis-server during integration runs
dump.rdb

# Built widget bundle copied into the WordPress plugin by `pnpm wp:bundle`.
wordpress/*/assets/ds-lms.js
# The portal serves its own copy of the widget bundle rather than pointing at
# the widget domain (see apps/portal/vite.config.ts). Same generated file, same
# reason not to track it.
apps/portal/public/ds-lms.js

# Production environment file, written on the host by the deploy workflow.
infra/deploy/.env.production

# Playwright's per-failure artefacts (P35-01). Traces and screenshots are for
# the run that produced them; a committed one is a stale picture of a bug that
# has since been fixed.
apps/e2e/test-results/
apps/e2e/playwright-report/
