{
  "name": "digitalspital-education-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild"
    ],
    "overrides": {
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "js-yaml@>=4.0.0 <4.3.0": "^4.3.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.8"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "wp:bundle": "pnpm --filter @ds/widget build && node scripts/bundle-widget.mjs wordpress/ds-lms/assets",
    "lint": "eslint .",
    "lint:env": "node scripts/env-audit.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "turbo run typecheck && tsc -p db/tsconfig.json --noEmit",
    "test": "turbo run test",
    "test:wp": "php wordpress/ds-lms/tests/security-test.php",
    "dev": "turbo run dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v && pnpm infra:up",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed/adhs.ts",
    "db:seed:default": "tsx db/seed/ds-default.ts",
    "db:seed:ds": "tsx db/seed/ds-demo.ts",
    "verify": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm audit --prod --audit-level=moderate",
    "test:integration": "node scripts/run-integration.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=moderate",
    "db:test": "node scripts/testdb.mjs",
    "db:test:fresh": "node scripts/testdb.mjs --fresh",
    "db:dev:reset": "node scripts/devdb.mjs",
    "db:dev:seed": "node scripts/devdb.mjs --keep",
    "test:integration:ci": "turbo run test:integration"
  },
  "devDependencies": {
    "@ds/config": "workspace:*",
    "@ds/migrator": "workspace:*",
    "@ds/seed": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "helmet": "^8.3.0"
  }
}
