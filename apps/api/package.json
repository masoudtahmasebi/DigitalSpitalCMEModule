{
  "name": "@ds/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "dev": "node dev.mjs",
    "dev:keycloak": "node dist/dev-keycloak.js",
    "start": "node dist/main.js",
    "lint": "echo \"linted by the root pass\""
  },
  "dependencies": {
    "@ds/domain": "workspace:*",
    "@ds/eiv-client": "workspace:*",
    "@ds/mail": "workspace:*",
    "@ds/migrator": "workspace:*",
    "@ds/plugin-api": "workspace:*",
    "@ds/postgres": "workspace:*",
    "@ds/secrets": "workspace:*",
    "@ds/seed": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@node-rs/argon2": "^2.0.2",
    "bwip-js": "^4.11.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ds/sdk": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
