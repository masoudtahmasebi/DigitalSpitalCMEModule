{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // `page.evaluate` bodies are type-checked as browser code even though this
    // package runs in Node, so both libraries have to be present.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
