# Copy to .env and adjust. Every variable the stack reads is listed here (P0-03).
# No real secret belongs in this file or in any committed file.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=ds_education
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# Migrations run as ds_migrator (owns the schema); the API runs as ds_app,
# which is deliberately not BYPASSRLS and owns nothing — see ADR-0002.
DATABASE_URL=postgres://ds_app:ds_app_dev@127.0.0.1:5432/ds_education
MIGRATION_DATABASE_URL=postgres://ds_migrator:ds_migrator_dev@127.0.0.1:5432/ds_education

# Integration tests only (apps/api/test/integration): seeds fixtures through
# the superuser, which BYPASSRLS — never the path the running API takes. The
# API always reads/writes through ds_app and pays the RLS cost, exactly as
# production does.
POSTGRES_SUPERUSER_URL=postgres://postgres:postgres@127.0.0.1:5432/ds_education

# ---------------------------------------------------------------------------
# Redis — JWKS cache (P1-03), rate limiting (P10-03), retry queues (P7-06)
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# The API validates every token against these independently. Issuer and
# audience are checked, not just the signature — a validly signed token minted
# for another client or realm must not be accepted (ADR-0003).
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/ds-dev
KEYCLOAK_AUDIENCE=ds-education-api
KEYCLOAK_JWKS_URI=http://127.0.0.1:8080/realms/ds-dev/protocol/openid-connect/certs

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3000
API_BASE_URL=http://127.0.0.1:3000

# Encrypts SMTP credentials and VNR passwords at rest (CLAUDE.md §4 invariant
# 7). 32 bytes, base64. Generate with:
#   openssl rand -base64 32
#
# Never commit a real value. Optional in development and test — the plaintext
# development cipher is used when it is empty — and **required in production**,
# where `loadConfig` refuses to start without it. Setting it locally is still
# worthwhile: it is what exercises the real construction before it matters.
#
# This was called APP_KMS_KEY here while the code read SECRETS_KMS_KEY, so
# setting it had no effect whatsoever. The name below is the one the API reads.
SECRETS_KMS_KEY=

# Parent domain for the staff session cookie (ADR-0012), so the admin console at
# verwaltung.… and the API at api.… are same-site and the browser attaches it.
# Leave empty in development, where both are on localhost and a Domain attribute
# would stop the cookie being stored at all.
# In production this is *derived* from BASE_DOMAIN and should not be typed —
# see infra/deploy/domains.sh. Only development sets it by hand, to nothing.
#   STAFF_COOKIE_DOMAIN=.digitalspital.com
STAFF_COOKIE_DOMAIN=

# Origins allowed to call the API, comma-separated. There is no default and no
# wildcard: a request from an origin not listed here is refused.
#
# For MEDICE this is the WordPress site's origin — and note that it is *not*
# the origin the widget bundle is served from, which may differ.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4321

# Request body ceilings. The font upload has its own, larger limit because a
# WOFF2 with a full Latin-Extended range legitimately exceeds the general one.
MAX_REQUEST_BODY_SIZE=1mb
MAX_FONT_BODY_SIZE=5mb

# Token validation tuning. The clock tolerance covers ordinary NTP drift
# between this host and Keycloak; the JWKS cache TTL bounds how long a rotated
# signing key takes to be picked up.
AUTH_CLOCK_TOLERANCE_SEC=5
JWKS_CACHE_TTL_SEC=3600

# development | test | production. Production additionally requires
# SECRETS_KMS_KEY above, and refuses the plaintext cipher.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Email — Mailpit in development, so nothing can reach a real recipient
# ---------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false

# ---------------------------------------------------------------------------
# EIV-FOBI
# ---------------------------------------------------------------------------
# The live service, per the Anerkennungsbescheid, is
#   https://punktemeldung.eiv-fobi.de/
# It is deliberately NOT the default. Pointing EIV_BASE_URL anywhere non-local
# additionally requires EIV_ALLOW_LIVE=yes, because the configured VNR belongs to
# a genuine accredited event and a submission there creates a real CME record for
# a real physician that cannot be withdrawn once the 7-day correction window
# closes.
EIV_BASE_URL=http://127.0.0.1:4010
EIV_MOCK_PORT=4010
EIV_ALLOW_LIVE=

# Submission worker (P7-06). Set EIV_WORKER_ENABLED=no on web instances when
# scaling horizontally so exactly one process drains the queue — though the
# claim function leases the rows it hands out, so running several is safe,
# merely wasteful.
EIV_WORKER_ENABLED=yes

# Where a Punktemeldung deadline alarm is posted (P10-06). Empty means
# "log only", which is the local default — every alert is logged at `error`
# whether or not this is set.
ALERT_WEBHOOK_URL=
EIV_SWEEP_INTERVAL_SEC=60
EIV_SWEEP_BATCH_SIZE=25

# --- Certificate delivery (P8-03) ------------------------------------------
# SMTP itself is configured per project in the admin console, not here — each
# customer's mail leaves from their own server with their own sender. These are
# the worker's knobs.
#
# Slower than the EIV sweep on purpose: a Punktemeldung races an 8-day
# statutory window, a certificate has no deadline and backs off over about a
# day. Delivery never gates the download, so a failure here costs nobody their
# Teilnahmebescheinigung.
CERTIFICATE_DELIVERY_ENABLED=yes
CERTIFICATE_DELIVERY_INTERVAL_SEC=300
CERTIFICATE_DELIVERY_BATCH_SIZE=25
# Where the download link in the email points. The portal, not the API: the
# link is for a person to click and has to land on a page that can sign them in.
PORTAL_BASE_URL=http://127.0.0.1:5175

# Supplied by the Ärztekammer per course. Leave blank locally; the mock accepts
# any non-empty pair. NEVER commit real values.
EIV_VNR=
EIV_VNR_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage for course media (P10-06)
# ---------------------------------------------------------------------------
# Optional as a group. Leave it all empty and courses serve media from plain
# `https://` URLs in the `contents` table, which is what a customer already
# running their own CDN wants. Set all of it and a course row may instead hold
# `s3://<customerId>/courses/<courseId>/<file>`, which the API signs — briefly,
# per object, and only after the sequence gate has agreed.
#
# S3-*compatible*, not Amazon. Hosting is Hetzner in Germany on purpose
# (CLAUDE.md §4), and course media for German physicians in a US-controlled
# bucket is a data-transfer question nobody wants to answer. Hetzner Object
# Storage and MinIO both speak plain SigV4.
#
# Isolation is the first path segment of every key, and it is derived from the
# validated token rather than read from the request — see
# packages/domain/src/storage-key.ts.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing. "no" switches to virtual-hosted (bucket as subdomain).
S3_FORCE_PATH_STYLE=yes
# How long a signed media URL stays usable. A presigned URL is a capability:
# one copied out of a browser's network tab works until it expires. Long enough
# to finish a 25-minute video, short enough that a leaked one is not forever.
S3_URL_TTL_SEC=3600
